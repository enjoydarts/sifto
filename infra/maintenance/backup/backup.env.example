# Install as /etc/sifto-maintenance/backup.env, root:root0600 after selecting
# the private sifto-backups-prod bucket. Keep the password in a recoverable vault.
# Root config must approve backup_destination={"bucket":"sifto-backups-prod","prefix":"database"}.
# On the application host use /application and prefix "application" instead.
# Never use the shared sifto-podcast-prod bucket for backups.
RESTIC_REPOSITORY=s3:https://REPLACE_ACCOUNT_ID.r2.cloudflarestorage.com/sifto-backups-prod/database
RESTIC_PASSWORD=REPLACE_WITH_INDEPENDENT_RANDOM_BACKUP_PASSWORD
AWS_ACCESS_KEY_ID=REPLACE_WITH_BUCKET_SCOPED_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BUCKET_SCOPED_SECRET
AWS_DEFAULT_REGION=auto
# Set only after approving the real destination and matching root configuration.
BACKUP_DESTINATION_APPROVED=REPLACE_WITH_database_OR_application
BACKUP_HOST_ID=REPLACE_WITH_EXACT_ROOT_CONFIG_HOST_ID
