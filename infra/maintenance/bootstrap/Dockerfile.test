FROM ubuntu:26.04@sha256:6a06111c3b0a8600feadb270aec771dc239bf407b25625f93f44ab00e11f4d3c
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-cryptography sudo openssh-client openssh-server util-linux passwd \
    && rm -rf /var/lib/apt/lists/*
COPY host_agent.py /fixture/host_agent.py
COPY maintenance/__init__.py maintenance/plan.py maintenance/host.py maintenance/coolify_standard.py /fixture/maintenance/
COPY bootstrap/install-host.sh bootstrap/test-install.sh /fixture/
