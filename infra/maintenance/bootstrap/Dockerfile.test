FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-cryptography sudo openssh-client openssh-server util-linux passwd \
    && rm -rf /var/lib/apt/lists/*
COPY host_agent.py /fixture/host_agent.py
COPY coolify_native_controller.py coolify_native_engine.py /fixture/
COPY systemd/sifto-coolify-native-controller.service /fixture/systemd/
COPY maintenance/coolify_systemd.py maintenance/coolify_native_protocol.py maintenance/coolify_cleanup.py maintenance/coolify_native_owner.py /fixture/maintenance/
COPY maintenance/__init__.py maintenance/plan.py maintenance/host.py maintenance/coolify_host.py maintenance/coolify_plan.py maintenance/coolify_rehearsal.py maintenance/coolify_evidence.py maintenance/coolify_docker.py maintenance/coolify_rehearsal_engine.py maintenance/coolify-public-manifest.json maintenance/coolify_probe.php /fixture/maintenance/
COPY maintenance/coolify_startup.py maintenance/coolify_startup_init maintenance/coolify_startup_middleware.php maintenance/coolify_startup_nginx.conf maintenance/coolify_startup_site.conf /fixture/maintenance/
COPY bootstrap/install-host.sh bootstrap/test-install.sh /fixture/
