{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "branchPrefix": "renovate-ci/",
  "automerge": false,
  "platformAutomerge": false,
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}{{{footer}}}",
  "prFooter": "Sifto requests owner approval in the production-maintenance Environment. After that approval, Sifto automatically merges and deploys the verified candidate. No manual PR merge is required.",
  "minimumReleaseAge": "7 days",
  "rebaseWhen": "behind-base-branch",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 5,
  "pinDigests": true,
  "enabledManagers": ["dockerfile", "docker-compose", "gomod", "pip-compile", "npm", "custom.regex"],
  "constraints": {"python": "==3.12.*", "uv": "0.13.0"},
  "npm": {
    "constraints": {"node": "22.23.4", "npm": "12.2.0"},
    "skipInstalls": false,
    "ignoreScripts": true,
    "npmrcMerge": false,
    "npmrc": "registry=https://registry.npmjs.org/\nallow-remote=none\nallow-git=none\nallow-file=none\nallow-directory=none\nignore-scripts=true\nreplace-registry-host=never\n"
  },
  "pip_requirements": {"enabled": false},
  "pip-compile": {
    "managerFilePatterns": ["/^(worker|infra/(maintenance|audio-concat))\\/requirements\\.txt$/"],
    "lockFileMaintenance": {"enabled": false}
  },
  "ignorePaths": ["shared/llm_catalog.json", "**/node_modules/**", "**/.next/**", ".worktrees/**"],
  "packageRules": [
    {
      "matchManagers": ["npm", "gomod", "pip-compile"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchFileNames": ["!infra/maintenance/**"],
      "groupName": "{{manager}} minor and patch dependencies"
    },
    {
      "matchUpdateTypes": ["digest", "pinDigest"],
      "matchFileNames": ["!infra/maintenance/**"],
      "groupName": "Docker image digests"
    },
    {
      "description": ["Respect the exact Alpine pin declined in https://github.com/enjoydarts/sifto/pull/21; distinct future pins remain eligible."],
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pinDigest"],
      "matchFileNames": ["api/Dockerfile"],
      "matchPackageNames": ["alpine"],
      "matchJsonata": ["packageFile = 'api/Dockerfile' and depName = 'alpine' and currentValue = 'latest' and newDigest = 'sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6'"],
      "enabled": false
    },
    {
      "description": ["Respect the exact Inngest pin declined in https://github.com/enjoydarts/sifto/pull/21; distinct future pins remain eligible."],
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pinDigest"],
      "matchFileNames": ["docker-compose.yml"],
      "matchPackageNames": ["inngest/inngest"],
      "matchJsonata": ["packageFile = 'docker-compose.yml' and depName = 'inngest/inngest' and currentValue = 'latest' and newDigest = 'sha256:9c4a2413bdbfa31a94ff54c32ae2dcc6613dbee84bc76db6cf6644d19e357e3e'"],
      "enabled": false
    },
    {
      "description": ["Respect the two exact Trivy pins declined in https://github.com/enjoydarts/sifto/pull/21; distinct future pins remain eligible."],
      "matchManagers": ["docker-compose"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pinDigest"],
      "matchFileNames": ["infra/dependency-ci/compose.yml", "infra/image-security/compose.yml"],
      "matchPackageNames": ["aquasec/trivy"],
      "matchJsonata": ["(packageFile = 'infra/dependency-ci/compose.yml' or packageFile = 'infra/image-security/compose.yml') and depName = 'aquasec/trivy' and currentValue = '0.75.0' and newDigest = 'sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa'"],
      "enabled": false
    },
    {
      "matchManagers": ["pip-compile"],
      "matchDepTypes": ["indirect"],
      "rangeStrategy": "update-lockfile",
      "enabled": false
    },
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["api/go.mod"],
      "matchDepTypes": ["indirect"],
      "matchPackageNames": ["google.golang.org/grpc", "golang.org/x/net"],
      "enabled": true
    },
    {
      "matchFileNames": ["infra/maintenance/Dockerfile", "infra/maintenance/requirements.in", "infra/maintenance/requirements.txt"],
      "groupName": "Maintenance executor activation dependencies",
      "groupSlug": "maintenance-executor-activation",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^api\\/Dockerfile$/"],
      "matchStrings": ["go install github\\.com/air-verse/air@(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)"],
      "depNameTemplate": "github.com/air-verse/air",
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    }
  ]
}
