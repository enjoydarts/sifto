FROM ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-cryptography sudo openssh-client openssh-server util-linux passwd \
    && rm -rf /var/lib/apt/lists/*
COPY host_agent.py /fixture/host_agent.py
COPY maintenance/__init__.py maintenance/plan.py maintenance/host.py /fixture/maintenance/
COPY bootstrap/install-host.sh bootstrap/test-install.sh /fixture/
